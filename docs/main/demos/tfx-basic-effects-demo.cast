[9.822000, "o", "\u001b[1;1H\u001b[0m┌\u001b[0;41m  \u001b[0mf\u001b[0;41m  \u001b[0mt\u001b[0;41m \u001b[0m \u001b[0;41m \u001b[0;2m2\u001b[0;41m  \u001b[0m────────────────────────────┐ ┌Con\u001b[0;41m  \u001b[0mn\u001b[0;41m \u001b[0m \u001b[0;41m   \u001b[0ma \u001b[0;41m  \u001b[0mex\u001b[0;41m  \u001b[0m────────────────────────────────────────────────────────┐\u001b[2;1H│  \u001b[0;2m── \u001b[0;41m   \u001b[0;2me ──\u001b[0m                            │ │\u001b[0;41m \u001b[0ma\u001b[0;41m     \u001b[0m T\u001b[0;41m  \u001b[0m E\u001b[0;41m  \u001b[0mec\u001b[0;41m  \u001b[0m \u001b[0;41m \u001b[0me\u001b[0;41m \u001b[0mo                                                   │\u001b[3;1H│  \u001b[0;41m    \u001b[0m T\u001b[0;41m \u001b[0m (R\u001b[0;41m \u001b[0mB\u001b[0;41m \u001b[0m                         │ │════════════════════                                                       │\u001b[4;1H│  \u001b[0;41m \u001b[0mad\u001b[0;41m \u001b[0m T\u001b[0;41m \u001b[0m \u001b[0;41m  \u001b[0mSL\u001b[0;41m \u001b[0m                         │ │                                                                           │\u001b[5;1H│  \u001b[0;41m  \u001b[0md\u001b[0;41m \u001b[0m \u001b[0;41m    \u001b[0m                             │ │\u001b[0;41m \u001b[0me\u001b[0;41m  \u001b[0mc\u001b[0;41m    \u001b[0m \u001b[0;41m \u001b[0mis\u001b[0;41m     \u001b[0m T\u001b[0;41m \u001b[0m                                                      │\u001b[6;1H│  \u001b[0;2m── \u001b[0;41m    \u001b[0;2mo\u001b[0;41m   \u001b[0;2m ──\u001b[0m                        │ │\u001b[0;41m   \u001b[0me\u001b[0;41m   \u001b[0my\u001b[0;41m \u001b[0m \u001b[0;41m \u001b[0mi\u001b[0;41m \u001b[0msolv\u001b[0;41m \u001b[0m                                                         │\u001b[7;1H│  \u001b[0;41m   \u001b[0ms\u001b[0;41m    \u001b[0m                              │ │                                                                           │\u001b[8;1H│\u001b[0;33;1m▶ D\u001b[0;41m \