  │ │• \u001b[0;41m       \u001b[0m \u001b[0;41m \u001b[0me\u001b[0;41m  \u001b[0m \u001b[0;41m    \u001b[0m \u001b[0;41m    \u001b[0m \u001b[0;41m \u001b[0mor\u001b[0;41m \u001b[0m \u001b[0;41m  \u001b[0mn\u001b[0;41m   \u001b[0mt                                      │\u001b[16;1H│  \u001b[0;41m \u001b[0ma\u001b[0;41m   \u001b[0m \u001b[0;41m \u001b[0mG                              │ │• \u001b[0;41m     \u001b[0m l\u001b[0;41m   \u001b[0m                                                               │\u001b[17;1H│  Pa\u001b[0;41m   \u001b[0m \u001b[0;41m \u001b[0mG                              │ │• \u001b[0;41m \u001b[0m l\u001b[0;41m   \u001b[0me\u001b[0;41m \u001b[0m \u001b[0;41m    \u001b[0m \u001b[0;41m  \u001b[0m \u001b[0;41m    \u001b[0m th\u001b[0;41m  \u001b[0m \u001b[0;41m    \u001b[0mn\u001b[0;41m     \u001b[0me\u001b[0;41m \u001b[0m \u001b[0;41m   \u001b[0m \u001b[0;41m       \u001b[0m w\u001b[0;41m  \u001b[0mk \u001b[0;41m   \u001b[0mo\u001b[0;41m \u001b[0ms \u001b[0;41m         \u001b[0m│\u001b[18;1H│  P\u001b[0;41m    \u001b[0m \u001b[0;41m    \u001b[0m                            │ │• \u001b[0;41m        \u001b[0m \u001b[0;41m    \u001b[0m567\u001b[0;41m  \u001b[0m0                                                      │\u001b[19;1H│  \u001b[0;2m── \u001b[0;41m   \u001b[0;2mter\u001b[0;41m  \u001b[0;2m ──\u001b[0m                        │ │• \u001b[0;41m        \u001b[0m \u001b[0;41m   \u001b[0m$\u001b[0;41m    \u001b[0m(\u001b[0;41m \u001b[0m                                                      │\u001b[20;1H│  \u001b[0;41m  \u001b[0md\u001b[0;41m \u001b[0m \u001b[0;41m \u001b[0m \u001b[0;41m     \u001b[0m \u001b[0;41m  \u001b[0m→R\u001b[0;41m \u001b[0m                    │ │• M\u001b[0;41m \u001b[0mxed: \u001b[0;41m \u001b[0me\u001b[0;41m   \u001b[0m \u001b[0;41m     \u001b[0m \u001b[0;41m    \u001b[0m                                                  │\u001b[21;1H│  F\u001b[0;41m   \u001b[0m \u001b[0;41m \u001b[0m \u001b[0;41m    \u001b[0ma\u001b[0;41