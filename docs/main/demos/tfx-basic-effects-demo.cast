;41m  \u001b[0m!                                                  │\u001b[21;1H│  F\u001b[0;41m \u001b[0mde \u001b[0;41m \u001b[0m \u001b[0;41m \u001b[0ma\u001b[0;41m \u001b[0mial                         │ │                                                                           │\u001b[22;1H│  \u001b[0;41m \u001b[0mad\u001b[0;41m \u001b[0m + D\u001b[0;41m  \u001b[0mg\u001b[0;41m   \u001b[0ml                       │ │\u001b[0;41m \u001b[0mta\u001b[0;41m \u001b[0mus: Ru\u001b[0;41m \u001b[0mn\u001b[0;41m \u001b[0mn\u001b[0;41m   \u001b[0m.                                                         │\u001b[23;1H│  \u001b[0;2m── Co\u001b[0;41m \u001b[0;2mp\u001b[0;41m     \u001b[0;2mo\u001b[0;41m \u001b[0;2m ──\u001b[0m                     │ │                                                                           │\u001b[24;1H│  \u001b[0;41m \u001b[0me\u001b[0;41m \u001b[0mu\u001b[0;41m   \u001b[0me                              │ │C\u001b[0;41m \u001b[0mnt\u001b[0;41m \u001b[0mo\u001b[0;41m  \u001b[0m:                                                                  │\u001b[25;1H│  \u001b[0;41m  \u001b[0mr\u001b[0;41m     \u001b[0m                              │ │  ↑\u001b[0;41m \u001b[0m↓  \u001b[0;41m \u001b[0m \u001b[0;41m     \u001b[0ma\u001b[0;41m  \u001b[0m \u001b[0;41m \u001b[0mf\u001b[0;41m \u001b[0me\u001b[0;41m   \u001b[0m                                                  │\u001b[26;1H│  \u001b[0;2m── In\u001b[0;41m       \u001b[0;2mti\u001b[0;41m  \u001b[0;2m ──\u001b[0m                   │ │  E\u001b[0;41m \u001b[0mte\u001b[0;41m      \u001b[0me - \u001b[0;41m \u001b[0mr\u001b[0;41m  \u001b[0mger e\u001b[0;41m     \u001b[0m                                             │\u001b[27;1H│  \u001b[0;41m    \u001b[0mc\u001b[0;41m \u001b[0m Ou\u001b[0;41m \u001b[0m                            │ │  \u001b[0;41m \u001b[0m \u001b[0;41m \u001b[0m T\u001b[0;41m  \u001b[0mg\u001b[0;41m \u001b[0me \u001b[0;41m \u001b[0me\u001b[0;41m  \u001b[0m/blo\u001b[0;41m \u001b[0mk\u00